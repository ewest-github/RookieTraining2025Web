{
  "compilerOptions": {
    "target":"ES6",
    "module":"commonjs",
    "rootDir": "src",
    "baseUrl": "./",
    "outDir": "build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict":true,
    "strictFunctionTypes": false,
  },
  "include": ["src/**/*"],
  "exclude": ["build","node_modules"]
}
